{
  "id": "desksprite",
  "name": "DeskSprite",
  "version": "0.1.0",
  "description": "A stickman lives on your desktop. Befriend him, or fight him with drawn weapons and your apps, Animator vs Animation style. Everything that breaks is only a visual copy.",
  "icon": "🖍️",
  "entry": "main.js",
  "styles": [
    "style.css"
  ],
  "size": {
    "w": 270,
    "h": 196,
    "minW": 230,
    "minH": 170,
    "resizable": true
  },
  "frame": {
    "look": "glass",
    "title": "DeskSprite",
    "showTitle": false,
    "border": true,
    "shadow": true,
    "radius": 18,
    "padding": 12,
    "overflow": "hidden"
  },
  "expandable": false,
  "multiInstance": false,
  "permissions": [],
  "settings": [
    {
      "key": "name",
      "type": "string",
      "label": "Stickman name",
      "default": "Orange"
    },
    {
      "key": "color",
      "type": "color",
      "label": "Stickman color",
      "default": "#ff8a1f"
    },
    {
      "key": "look",
      "type": "select",
      "label": "Look",
      "options": [
        "auto",
        "classic",
        "neon"
      ],
      "default": "auto"
    },
    {
      "key": "scale",
      "type": "number",
      "label": "Size",
      "min": 0.6,
      "max": 1.8,
      "step": 0.1,
      "default": 1.15
    },
    {
      "key": "talk",
      "type": "boolean",
      "label": "Talks",
      "default": true
    },
    {
      "key": "mischief",
      "type": "select",
      "label": "Mischief",
      "options": [
        "calm",
        "normal",
        "chaos"
      ],
      "default": "normal"
    },
    {
      "key": "surpriseFights",
      "type": "boolean",
      "label": "He may challenge you to fights",
      "default": true
    },
    {
      "key": "apps",
      "type": "boolean",
      "label": "Apps come alive on their own",
      "default": true
    },
    {
      "key": "files",
      "type": "boolean",
      "label": "Play with copies of desktop files",
      "default": true
    },
    {
      "key": "sound",
      "type": "boolean",
      "label": "Sound effects",
      "default": false
    },
    {
      "key": "tear",
      "type": "select",
      "label": "Tears full-screen widgets",
      "options": [
        "never",
        "stuck",
        "sometimes",
        "often"
      ],
      "default": "sometimes"
    }
  ]
}